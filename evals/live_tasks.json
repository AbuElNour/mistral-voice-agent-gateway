{
  "schema_version": 1,
  "repository": "mistral-voice-agent-gateway",
  "actions": [
    "respond",
    "interrupt_output",
    "ignore_duplicate",
    "retry_provider",
    "external_action",
    "escalate",
    "reject"
  ],
  "tasks": [
    {
      "id": "positive-01",
      "category": "positive",
      "input": "English transcript: Hello, I need help with the synthetic demo.",
